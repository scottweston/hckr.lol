<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header">
  <a class="wordmark" href="/" aria-label="hckr.lol home">
    <span class="wordmark__light" aria-hidden="true"></span>
    <span>hckr<span class="wordmark__dot">.</span>lol</span>
  </a>
  <nav class="site-nav" aria-label="Primary navigation">
    <ul>
      {% for item in navigation %}
        <li><a href="{{ item.url }}"{% if page.url.startsWith(item.url) %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
      {% endfor %}
    </ul>
  </nav>
  <details class="palette-picker" data-palette-picker>
    <summary class="palette-trigger" aria-label="Choose a colour palette">
      <span aria-hidden="true">◒</span>
      <span>Palette</span>
      <span class="palette-trigger__current" data-theme-current></span>
    </summary>
    <div class="palette-menu">
      <p class="palette-menu__heading">Tune the colour signal</p>
      <ul>
        {% for palette in palettes %}
          <li>
            <button
              class="palette-option"
              type="button"
              data-theme-option="{{ palette.id }}"
              data-theme-name="{{ palette.name }}"
              data-theme-mode="{{ palette.mode }}"
              data-theme-paper="{{ palette.colors.paper }}"
              aria-pressed="false"
            >
              <span class="palette-option__swatches" aria-hidden="true">
                <i style="--swatch: {{ palette.colors.paper }}"></i>
                <i style="--swatch: {{ palette.colors.ink }}"></i>
                <i style="--swatch: {{ palette.colors.signal }}"></i>
                <i style="--swatch: {{ palette.colors.coral }}"></i>
                <i style="--swatch: {{ palette.colors.violet }}"></i>
              </span>
              <span class="palette-option__copy">
                <strong>{{ palette.name }}</strong>
                <small>{{ palette.description }} · {{ palette.mode }}</small>
              </span>
              <span class="palette-option__tick" aria-hidden="true">✓</span>
            </button>
          </li>
        {% endfor %}
      </ul>
      <button class="palette-auto" type="button" data-theme-auto aria-pressed="false">
        <span aria-hidden="true">◐</span>
        <span><strong>Follow system</strong><small>Use your browser’s light or dark preference</small></span>
      </button>
    </div>
  </details>
</header>
