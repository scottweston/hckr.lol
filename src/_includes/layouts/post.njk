---
layout: layouts/base.njk
---
<article class="page-shell h-entry">
  <header class="page-heading page-heading--post">
    <p class="eyebrow">Field note № {{ collections.posts | length }}</p>
    <h1 class="p-name">{{ title }}</h1>
    <p class="post-meta">
      <time class="dt-published" datetime="{{ date.toISOString() }}">{% if showTime %}{{ date | readableDateTime }}{% else %}{{ date | readableDate }}{% endif %}</time>
      <span aria-hidden="true">/</span>
      <span>{{ readingTime or "3 min read" }}</span>
    </p>
  </header>
  <div class="prose e-content">
    {{ content | safe }}
  </div>
  <footer class="post-footer">
    <p>Written on the open web by <a class="p-author h-card" href="/">{{ site.author }}</a>.</p>
    <a href="/blog/">← All field notes</a>
  </footer>
</article>
